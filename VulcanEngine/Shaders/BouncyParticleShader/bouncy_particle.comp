#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Match the c++ struct
struct Particle {
    vec4 positionLife;
    vec4 velocitySize;
    vec4 color;
    vec4 initPosLife;
    vec3 initVelocity;
};

// Storage buffer for particle data (r/w)
layout(std430, binding = 0) restrict buffer ParticleBuffer {
    uint particleCount;
    Particle particles[];
} particleBuffer;

layout(binding = 1) uniform SimulationParams {
    vec4 gravityDeltaTime;
    vec4 windDamping;
    vec4 particlesPosLife;
} params;

void main() {
    uint index = gl_GlobalInvocationID.x;

    if (index >= particleBuffer.particleCount) return;

    Particle p = particleBuffer.particles[index];

    // Reset dead particles
    if (p.positionLife.w <= 0.0) {
        p.positionLife = p.initPosLife;  // emitter position (should be passed as uniform)
        p.velocitySize.xyz = p.initVelocity;
        particleBuffer.particles[index] = p;
        return;
    }

    // Update velocity and forces
    p.velocitySize += vec4(params.gravityDeltaTime.xyz * params.gravityDeltaTime.w, 0.0);
    p.velocitySize += vec4(params.windDamping.xyz * params.gravityDeltaTime.w, 0.0);
    p.velocitySize.xyz *= pow(params.windDamping.w, params.gravityDeltaTime.w);

    // upd position
    p.positionLife += vec4(p.velocitySize.xyz * params.gravityDeltaTime.w, 0.0);

    // upd lifetime
    p.positionLife.w -= params.gravityDeltaTime.w;

    // Simple floor collision
    if (p.positionLife.y < 0.0) {
        p.positionLife.y = 0.0;
        p.velocitySize.y *= -0.999; // Bounce with energy loss

        // // SUPER CHAOS 
        // p.velocitySize.xyz *= 1.05;
        
        // // Generate a pseudo-random 3D vector based on the particle's index
        // float seed = float(index) * 12.9898 + p.positionLife.x * 78.233;
        // vec3 randomKick = vec3(
        //     fract(sin(seed) * 43758.5453),
        //     fract(sin(seed * 1.2) * 24651.123),
        //     fract(sin(seed * 1.5) * 65432.321)
        // ) * 2.0 - 1.0; // Maps to range [-1.0, 1.0]
        
        // // Apply the random explosion kick
        // p.velocitySize.xyz += randomKick * 3.0; // 3.0 is the kick strength
    }

    // // MAGNETIC FIELD
    // vec3 magneticField = vec3(0.0, 1.0, 0.0); // Direction of the magnetic field
    // // F = q(v x B)
    // vec3 lorentzForce = cross(p.velocitySize.xyz, magneticField) * 2.0; 
    // p.velocitySize.xyz += lorentzForce * params.gravityDeltaTime.w;

    // // LIGHTWEIGHT CURL NOISE
    // vec3 pos = p.positionLife.xyz * 0.5; // Scale down to make swirls larger
    
    // // This specific combination of sin/cos derivatives mathematically 
    // // approximates a divergence-free vector field.
    // vec3 curlForce = vec3(
    //     sin(pos.y) * cos(pos.z),
    //     sin(pos.z) * cos(pos.x),
    //     sin(pos.x) * cos(pos.y)
    // );
    
    // p.velocitySize.xyz += curlForce * 3.0 * params.gravityDeltaTime.w;

    // Write back updated particle
    particleBuffer.particles[index] = p;
}