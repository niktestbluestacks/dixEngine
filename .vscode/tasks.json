{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate Source List",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}/scripts/generate_sources.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "isBackground": false
    },
    {
      "label": "Make: Build",
      "type": "shell",
      "command": "mingw32-make.exe",
      "args": [
        "-j8"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
  ]
}